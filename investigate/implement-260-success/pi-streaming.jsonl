th\": \"fill_container\",\n          \"content\": \"Keyboard shortcuts\",\n          \"fontFamily\": \"$font\",\n          \"fontSize\": 13,\n          \"fontWeight\": \"normal\"\n        },\n        {\n          \"type\": \"text\",\n          \"id\": \"mpIOp\",\n          \"x\": 0,\n          \"y\": 0,\n          \"name\": \"Shortcut\",\n          \"enabled\": false,\n          \"fill\": \"$faint\",\n          \"content\": \"E\",\n          \"fontFamily\": \"$font\",\n          \"fontSize\": 11,\n          \"fontWeight\": \"normal\"\n        }\n      ],\n      \"component\": {\n        \"id\": \"ZsXwz\",\n        \"name\": \"Menu Item\"\n      }\n    },\n    {\n      \"type\": \"rectangle\",\n      \"id\": \"tPGQd\",\n      \"name\": \"Divider\",\n      \"fill\": \"$border\",\n      \"width\": \"fill_container(224)\",\n      \"height\": 1,\n      \"component\": {\n        \"id\": \"hAjWQ\",\n        \"name\": \"Divider\"\n      }\n    },\n    {\n      \"type\": \"frame\",\n      \"id\": \"orkKb\",\n      \"name\": \"Sign Out Item\",\n      \"width\": \"fill_container(204)\",\n      \"fill\": \"$transparent\",\n      \"cornerRadius\": 6,\n      \"gap\": 9,\n      \"padding\": [\n        7,\n        9\n      ],\n      \"alignItems\": \"center\",\n      \"children\": [\n        {\n          \"type\": \"icon\",\n          \"id\": \"sctil\",\n          \"name\": \"Icon\",\n          \"width\": 14,\n          \"height\": 14,\n          \"icon\": \"log-out\",\n          \"library\": \"lucide\",\n          \"fill\": \"$danger\"\n        },\n        {\n          \"type\": \"text\",\n          \"id\": \"mAcu3\",\n          \"name\": \"Label\",\n          \"fill\": \"$danger\",\n          \"textGrowth\": \"fixed-width\",\n          \"width\": \"fill_container\",\n          \"content\": \"Sign out\",\n          \"fontFamily\": \"$font\",\n          \"fontSize\": 13,\n          \"fontWeight\": \"normal\"\n        },\n        {\n          \"type\": \"text\",\n          \"id\": \