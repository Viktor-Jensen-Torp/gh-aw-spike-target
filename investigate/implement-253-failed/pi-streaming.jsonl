ByRole('button', { name: 'Create account' }).click();\n\n  // Error message should be shown on the email field\n  await expect(\n    page.getByText(\n      'This email is already in use. Sign in instead or reset your password.',\n    ),\n  ).toBeVisible();\n\n  // Should still be on sign-up page\n"}]},"isError":false}
