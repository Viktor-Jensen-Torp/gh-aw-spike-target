ingify({ status: 'ok' }), { status: 200 });\n      }\n      if (url.includes('/api/me')) {\n        return new Response(\n          JSON.stringify({\n            user: {\n              id: '1',\n              fullName: 'Mara Reyes',\n              email: 'mara@example.com',\n            },\n          }),\n          { status: 200 },\n        );\n      }\n      if (url.includes('/api/auth/sign-out')) {\n        return new Response(JSON.stringify({}), { status: 200 });\n      }\n      return new Response('', { status: 404 });\n    }),\n  );\n}\n\nfunction mockSignOutFailure() {\n  vi.stubGlobal(\n    'fetch',\n    vi.fn(async (url: string) => {\n      if (url.includes('/api/health')) {\n        return new Response(JSON.stringify({ status: 'ok' }), { status: 200 });\n      }\n      if (url.includes('/api/me')) {\n        return new Response(\n          JSON.stringify({\n            user: {\n              id: '1',\n              fullName: 'Mara Reyes',\n              email: 'mara@example.com',\n            },\n          }),\n          { status: 200 },\n        );\n      }\n      if (url.includes('/api/auth/sign-out')) {\n        return new Response(\n          JSON.stringify({\n            error: { code: 'sign_out_failed', message: 'Signing out failed' },\n          }),\n          { status: 500 },\n        );\n      }\n      return new Response('', { status: 404 });\n    }),\n  );\n}\n\nafterEach(() => vi.unstubAllGlobals());\n\ndescribe('HomePage', () => {\n  it(\"shows the app's name as the page heading\", () => {\n    mockApi();\n    render(\n      <UserProvider>\n        <HomePage />\n      </UserProvider>,\n    );\n    expect(screen.getByRole('heading', { name: 'Tempo' })).toBeInTheDocument();\n  });\n\n  it('shows \"API: ok\" when the API responds', async () => {\n    mockApi();\n    render(\n      <UserProvider>\n        <HomePage />\n      </UserProvider>,\n    );\n    await expect(screen.findByText('API: ok')).resolves.toBeInTheDocument();\n  });\n\n  it('shows \"API: unavailable\" when the API does not answer', async () => {\n    mockApiError();\n    render(\n      <UserProvider>\n        <HomePage />\n      </UserProvider>,\n    );\n    await expect(\n      screen.findByText('API: unavailable'),\n    ).resolves.toBeInTheDocument();\n  });\n\n  describe('user menu accessibility', () => {\n    it('Given I am signed in - When I open the user menu - Then its trigger is announced as expanded', async () => {\n      mockApi();\n      render(\n        <UserProvider>\n          <HomePage />\n        </UserProvider>,\n      );\n\n      // Wait for the user card to appear\n      const userButton = await screen.findByRole('button', {\n        name: 'Mara Reyes',\n      });\n\n      // Before clicking, aria-expanded should not be set by us (Radix will set it)\n      // Initially the menu should be closed\n      expect(userButton).not.toHaveAttribute('aria-expanded', 'false');\n\n      // Click to open menu\n      const user = userEvent.setup();\n      await user.click(userButton);\n\n      // After opening, Radix should have set aria-expanded=\"true\"\n      expect(userButton).toHaveAttribute('aria-expanded', 'true');\n\n      // Menu items should be visible\n      expect(screen.getByRole('menuitem', { name: /Sign out/i })).toBeInTheDocument();\n    });\n  });\n\n  describe('sign-out error handling', () => {\n    it('Given signing out fails - When I choose \"Sign out\" - Then I stay on the page and see that signing out failed', async () => {\n      mockSignOutFailure();\n      render(\n        <UserProvider>\n          <HomePage />\n        </UserProvider>,\n      );\n\n      // Wait for the user card to appear\n      const userButton = await screen.findByRole('button', {\n        name: 'Mara Reyes',\n      });\n\n      // Open the menu\n      const user = userEvent.setup();\n      await user.click(userButton);\n\n      // Click Sign out\n      const signOutButton = screen.getByRole('menuitem', { name: /Sign out/i });\n      await user.click(signOutButton);\n\n      // Wait for error message to appear\n      const errorMessage = await screen.findByText('Signing out failed');\n\n      // Verify we're still on the page and see the error\n      expect(errorMessage).toBeInTheDocument();\n      expect(screen.getByRole('heading', { name: 'Tempo' })).toBeInTheDocument();\n    });\n  });\n\n  describe('API calls count', () => {\n    it('Given I open the start page - Then GET /api/me is requested once', async () => {\n      mockApi();\n      const fetchSpy = vi.spyOn(global, 'fetch');\n\n      render(\n        <UserProvider>\n          <HomePage />\n        </UserProvider>,\n      );\n\n      // Wait for the user card to appear (which means /api/me was called)\n      await screen.findByRole('button', { name: 'Mara Reyes' });\n\n      // Count how many times /api/me was called\n      const meApiCalls = fetchSpy.mock.calls.filter((call) =>\n        call[0].includes('/api/me'),\n      );\n\n      // Should only be called once\n      expect(meApiCalls).toHaveLength(1);\n\n      fetchSpy.mockRestore();\n    });\n  });\n});\n"}}],"api":"anthropic-messages","provider":"aw-gateway","model":"claude-haiku-4-5-20251001","usage":{"input":5,"output":1949,"cacheRead":37778,"cacheWrite":159,"totalTokens":39891,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0},"cacheWrite1h":0},"stopReason":"toolUse","timestamp":1790845708893,"responseId":"msg_011CfbFi1QaYSJtXKXYc8mJV","rawStopReason":"tool_use"},{"role":"toolResult","toolCallId":"toolu_01MMiBEhG7N41bgzprB3Zpak","toolName":"write","content":[{"type":"text","text":"Successfully wrote to /home/runner/work/gh-aw-spike-target/gh-aw-spike-target/apps/web/src/features/home/HomePage.test.tsx"}],"isError":false,"timestamp":1790845724805},{"role":"assistant","content":[{"type":"text","text":"Now let's run the tests to see if they pass:"},{"type":"toolCall","id":"toolu_018CLeN4vCi5kC9W5981gH52","name":"bash","arguments":{"command":"cd /home/runner/work/gh-aw-s