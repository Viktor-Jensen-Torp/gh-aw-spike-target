{"type":"tool_execution_end","toolCallId":"toolu_01YZc96t28LZUMgYFwSSne6A","toolName":"read","result":{"content":[{"type":"text","text":"import {\n  createContext,\n  useContext,\n  useEffect,\n  useState,\n  type ReactNode,\n} from 'react';\nimport { api, ApiClientError } from './api-client.ts';\nimport { MeResponse } from '@tempo/shared/auth';\n\ninterface User {\n  id: string;\n  fullName: string;\n  email: string;\n}\n\ninterface UserContextType {\n  user: User | null;\n  isLoading: boolean;\n  isSignedIn: boolean;\n  refetch: () => void;\n}\n\nconst UserContext = createContext<UserContextType | undefined>(undefined);\n\n/**\n * Provides the user session to the entire app.\n * Fetches GET /api/me once per page load and when refetched.\n */\nexport function UserProvider({ children }: { children: ReactNode }) {\n  const [user, setUser] = useState<User | null>(null);\n  const [isLoading, setIsLoading] = useState(true);\n  const [isSignedIn, setIsSignedIn] = useState(false);\n  const [refetchCount, setRefetchCount] = useState(0);\n\n  const refetch = () => {\n    setRefetchCount((count) => count + 1);\n  };\n\n  useEffect(() => {\n    async function checkSession() {\n      try {\n        const response = await api('/me', MeResponse);\n        setUser(response.user);\n        setIsSignedIn(true);\n      } catch (error) {\n        if (error instanceof ApiClientError && error.status === 401) {\n          setIsSignedIn(false);\n        } else {\n          // For other errors, treat as signed out\n          setIsSignedIn(false);\n        }\n        setUser(null);\n      } finally {\n        setIsLoading(false);\n      }\n    }\n\n    checkSession();\n  }, [refetchCount]);\n\n  return (\n    <UserContext.Provider value={{ user, isLoading, isSignedIn, refetch }}>\n      {children}\n    </UserContext.Provider>\n  );\n}\n\n/**\n * Hook to access the user session from anywhere in the app.\n * Must be used within a UserProvider.\n */\nexport function useUser(): UserContextType {\n  const context = useContext(UserContext);\n  if (!context) {\n    throw new Error('useUser must be used within a UserProvider');\n  }\n  return context;\n}\n"}]},"isError":false}
